NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key
# These are browser-visible values. RLS and RPC authorization protect member data.
# Never put service-role keys or database passwords in NEXT_PUBLIC variables.

# Optional: public site URL for share links, and the coordinator address shown on the public page.
NEXT_PUBLIC_SITE_URL=https://newfuturebank.com
NEXT_PUBLIC_COMMUNITY_CONTACT_EMAIL=
